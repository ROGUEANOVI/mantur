# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local to version control.
#
# Where to find these values:
#   Supabase Dashboard → Project Settings → API
#   - Project URL       → NEXT_PUBLIC_SUPABASE_URL
#   - anon / public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - service_role key  → SUPABASE_SERVICE_ROLE_KEY  (keep secret — server only)

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-side only — never expose to the browser.
# Used by createAdminClient() to bypass RLS for trusted server operations.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Google OAuth — only read locally by `supabase start` (supabase/config.toml).
# The hosted/production project does NOT read these — its Google credentials
# are entered directly in Supabase Dashboard → Authentication → Providers.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-oauth-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google-oauth-client-secret>

# Upstash Redis — used by src/lib/rate-limit.ts to rate-limit Server Actions
# (login/signup, bookings, role requests, transport requests). Get these from
# your database's REST API panel at https://console.upstash.com.
UPSTASH_REDIS_REST_URL=<upstash-redis-rest-url>
UPSTASH_REDIS_REST_TOKEN=<upstash-redis-rest-token>

# Resend — used by src/lib/email/ to notify applicants when their role
# request (business owner / transporter / tourist guide) is approved or
# rejected. Get an API key at https://resend.com/api-keys. The sender
# domain (mantur.co) must be verified in the Resend dashboard.
RESEND_API_KEY=<resend-api-key>

# Wompi — real payment gateway integration (see
# docs/wompi-alegra-integration-plan.md). Get sandbox keys from
# https://comercios.wompi.co (Desarrollo → Llaves de API). Use the
# pub_sandbox_/priv_sandbox_/sandbox_ prefixed keys during development;
# never use production keys outside the final production cutover.
WOMPI_PUBLIC_KEY=<pub_sandbox-or-prod-public-key>
WOMPI_PRIVATE_KEY=<priv_sandbox-or-prod-private-key>
WOMPI_INTEGRITY_SECRET=<integrity-secret-for-checkout-signature>
WOMPI_EVENTS_SECRET=<events-secret-for-webhook-checksum>
# Base URL for Wompi's transactional REST API (create/query/void a
# transaction) — confirmed from Wompi's public docs, unlike the Payouts
# host below. Sandbox: https://sandbox.wompi.co/v1
# Production: https://production.wompi.co/v1 — these are different hosts,
# so this must be set explicitly per environment rather than assumed.
WOMPI_API_BASE_URL=<https://sandbox.wompi.co/v1-or-https://production.wompi.co/v1>

# Wompi Payouts (Pagos a Terceros) — separate product/credentials from the
# checkout above, used by src/lib/wompi/payouts.ts to pay a business/guide
# their net share once a booking is confirmed. Get these from
# https://comercios.wompi.co (Desarrollo → Pagos a Terceros).
# WOMPI_PAYOUTS_BASE_URL is NOT published in Wompi's public docs at the time
# this was written — copy it from your own dashboard/API reference rather
# than guessing; sendProviderPayout() fails loudly if it's missing rather
# than calling a possibly-wrong host.
WOMPI_PAYOUTS_BASE_URL=<payouts-api-base-url-from-your-wompi-dashboard>
WOMPI_PAYOUTS_API_KEY=<payouts-x-api-key>
WOMPI_PAYOUTS_USER_PRINCIPAL_ID=<payouts-user-principal-id>
# The origin account funds are disbursed from — obtained from Wompi's own
# GET /accounts endpoint (see docs/wompi-alegra-integration-plan.md §4.4).
WOMPI_PAYOUTS_ACCOUNT_ID=<payouts-origin-account-id>

# Alegra — reserved for the electronic invoicing integration
# (see docs/wompi-alegra-integration-plan.md). Not yet consumed by any
# code path. Generate an API token from https://developer.alegra.com once
# the account is confirmed to be on a plan with API/integration access.
ALEGRA_USER=<alegra-account-email>
ALEGRA_TOKEN=<alegra-api-token>
